generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  // Ladder position. levelIdx indexes LEVELS (0 = 1C, the starting level);
  // colorIdx indexes the color within that level; pbPassed is how many of the
  // 6 required passing Power Builder sets the reader has cleared in the current
  // color. Progression is owned server-side (lib/ladder.js advanceProgress).
  levelIdx     Int      @default(0)
  colorIdx     Int      @default(0)
  pbPassed     Int      @default(0)
  // The reader's own advancement rule: how many passing Power Builder sets are
  // needed before a color's exit/level test. 0 means only a test is needed.
  setsToPass   Int      @default(6)
  // Bumped on password change; embedded in every issued JWT and compared on
  // each request so a stolen session token is invalidated the moment the
  // password is rotated, instead of staying valid until the 7-day JWT expiry.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  reports      Report[]
  notifications Notification[]

  @@index([email])
}

model Report {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period            String
  // 'powerbuilder' | 'exit_test' | 'level_test'
  kind              String
  levelIdx          Int
  colorIdx          Int
  // Number of Power Builder sets logged in this report (0 for tests).
  pbCount           Int
  score             Int
  rate              Int
  // Whether the report's score met the passing threshold.
  passed            Boolean
  // For a level test: the color index the reader was placed at in the next
  // level. Null for other report kinds.
  placementColorIdx Int?
  xp                Int
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
}

// Persisted, per-user notifications generated by real events (a welcome on
// signup, a "level up" when a report advances the ladder). Read state is
// stored here — not just held in the client — so marking them read survives a
// reload instead of the same items re-appearing every visit.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
